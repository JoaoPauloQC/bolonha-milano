@startuml diagrama-classes
!pragma layout smetana
title Bolonha e Milano - Diagrama de classes (Etapa 8 - final)
skinparam classAttributeIconSize 0
hide empty members

class Main {
  + {static} main(args: String[]): void
}

class Menu {
  - {static} CIDADES_SUGERIDAS: String[]
  - scanner: Scanner
  - emExecucao: boolean
  - partida: Partida
  - cidade: Cidade
  - mercado: Mercado
  - agricultura: Agricultura
  - governo: Governo
  - construcoes: Construcoes
  - nobreza: Nobreza
  - eventos: Eventos
  + executar(): void
  - exibirOpcoes(): void
  - lerOpcao(): int
  - lerInteiro(): int
  - exigirJogoEmAndamento(): boolean
  - processarOpcao(opcao: int): void
  - iniciarNovoJogo(): void
  - exibirStatus(): void
  - abrirMercado(): void
  - lerQuantidade(): int
  - comprarGraos(): void
  - venderGraos(): void
  - comprarTerras(): void
  - venderTerras(): void
  - abrirAgricultura(): void
  - colher(): void
  - distribuirAlimentos(): void
  - abrirGoverno(): void
  - arrecadarImpostos(): void
  - definirTaxaImposto(): void
  - definirJustica(): void
  - abrirConstrucoes(): void
  - recrutarSoldados(): void
  - construir(): void
  - encerrarTurno(): void
  - anunciarEventos(): void
  - exibirClassificacao(): void
  - encerrarPartida(): void
  - exibirSobre(): void
}

class Partida {
  + {static} MAXIMO_JOGADORES: int = 4
  - {static} ANO_FINAL: int = 1410
  - cidades: List<Cidade>
  - indiceAtual: int
  + adicionarCidade(cidade: Cidade): boolean
  + getCidades(): List<Cidade>
  + getCidadeAtual(): Cidade
  + getAnoAtual(): int
  + getAnoFinal(): int
  + passarTurno(): boolean
  + encerrarAno(nobreza: Nobreza): List<Cidade>
  + terminou(): boolean
  + determinarVencedor(nobreza: Nobreza): Cidade
  - estaNaFrente(a: Cidade, b: Cidade, nobreza: Nobreza): boolean
}

class Jogador {
  - {static} TITULOS: String[]
  - nome: String
  - nivelTitulo: int
  + Jogador(nome: String)
  + getNome(): String
  + getTitulo(): String
  + getNivelTitulo(): int
  + promover(): boolean
  + ehMonarca(): boolean
}

class Cidade {
  - nome: String
  - anoAtual: int
  - dono: Jogador
  - florins: int
  - terras: int
  - graos: int
  - servos: int
  - taxaImposto: int
  - nivelJustica: String
  - soldados: int
  - construcoes: int
  - colheitaFeita: boolean
  - impostosArrecadados: boolean
  + Cidade(nome: String, dono: Jogador)
  + getNome(): String
  + getAnoAtual(): int
  + getDono(): Jogador
  + getFlorins(): int
  + getTerras(): int
  + getGraos(): int
  + getServos(): int
  + getSoldados(): int
  + getConstrucoes(): int
  + getTaxaImposto(): int
  + setTaxaImposto(taxa: int): void
  + getNivelJustica(): String
  + setNivelJustica(nivel: String): void
  + avancarAno(): void
  + isColheitaFeita(): boolean
  + marcarColheitaFeita(): void
  + isImpostosArrecadados(): boolean
  + marcarImpostosArrecadados(): void
  + adicionarFlorins(qtd: int): void
  + removerFlorins(qtd: int): boolean
  + adicionarTerras(qtd: int): void
  + removerTerras(qtd: int): boolean
  + adicionarGraos(qtd: int): void
  + removerGraos(qtd: int): boolean
  + adicionarServos(qtd: int): void
  + removerServos(qtd: int): boolean
  + adicionarSoldados(qtd: int): void
  + removerSoldados(qtd: int): boolean
  + adicionarConstrucoes(qtd: int): void
  + removerConstrucoes(qtd: int): boolean
  + exibirStatus(): void
}

class Mercado {
  - {static} PRECO_GRAO: int = 2
  - {static} PRECO_TERRA: int = 1
  + getPrecoGrao(): int
  + getPrecoTerra(): int
  + comprarGraos(cidade: Cidade, qtd: int): boolean
  + venderGraos(cidade: Cidade, qtd: int): boolean
  + comprarTerras(cidade: Cidade, qtd: int): boolean
  + venderTerras(cidade: Cidade, qtd: int): boolean
}

class Agricultura {
  - {static} HECTARES_POR_SERVO: int = 5
  - {static} RENDIMENTO_POR_HECTARE: int = 2
  - {static} SERVOS_POR_GRAO: int = 5
  - {static} CRESCIMENTO_PERCENTUAL: int = 5
  - {static} PERCENTUAL_MINIMO: int = 20
  - {static} PERCENTUAL_MAXIMO: int = 80
  + processarColheita(cidade: Cidade): int
  + distribuirAlimentos(cidade: Cidade, percentual: int): boolean
}
note bottom of Agricultura : processarColheita devolve -1\nse a cidade ja colheu no ano

class Governo {
  - {static} TAXA_MAXIMA: int = 50
  - {static} MULTIPLICADOR_JUSTA: double = 0.8
  - {static} MULTIPLICADOR_MODERADA: double = 1.0
  - {static} MULTIPLICADOR_SEVERA: double = 1.3
  + arrecadarImpostos(cidade: Cidade): int
  + definirTaxaImposto(cidade: Cidade, taxa: int): boolean
  + definirJustica(cidade: Cidade, nivel: String): boolean
  - multiplicadorPara(nivel: String): double
}
note bottom of Governo : arrecadarImpostos devolve -1\nse a cidade ja arrecadou no ano

class Construcoes {
  - {static} PRECO_SOLDADO: int = 5
  - {static} SERVOS_POR_SOLDADO: int = 1
  - {static} PRECO_CONSTRUCAO: int = 20
  + getPrecoSoldado(): int
  + getPrecoConstrucao(): int
  + recrutarSoldados(cidade: Cidade, qtd: int): boolean
  + construir(cidade: Cidade, qtd: int): boolean
}

class Nobreza {
  - {static} PESO_CONSTRUCAO: int = 10
  - {static} PESO_SOLDADO: int = 2
  - {static} PESO_SERVO: int = 1
  - {static} HECTARES_POR_PONTO: int = 100
  - {static} PRESTIGIO_MINIMO: int[] = {0, 400, 550, 700, 850, 1000}
  + calcularPrestigio(cidade: Cidade): int
  + prestigioParaProximoTitulo(jogador: Jogador): int
  + verificarPromocao(cidade: Cidade): boolean
}

class Testes {
  - {static} aprovados: int
  - {static} reprovados: int
  + {static} main(args: String[]): void
  - {static} verificar(descricao: String, condicao: boolean): void
  - {static} novaCidade(): Cidade
  - {static} testarCidade(): void
  - {static} testarMercado(): void
  - {static} testarAgricultura(): void
  - {static} testarGoverno(): void
  - {static} testarConstrucoes(): void
  - {static} testarJogadorENobreza(): void
  - {static} testarPartida(): void
  - {static} testarEventos(): void
}
note top of Testes
  Segundo main: testa as regras.
  Nenhuma classe do jogo conhece Testes.
end note

class Eventos <<extra>> {
  - {static} SERVOS_POR_SOLDADO_NA_DEFESA: int = 10
  - random: Random
  + Eventos()
  + Eventos(random: Random)
  + sortearEvento(cidade: Cidade): String
  + aplicarEvento(cidade: Cidade, sorteio: int): String
  + cidadeEstaDefendida(cidade: Cidade): boolean
}

Main ..> Menu : cria e usa
Menu --> "0..1" Partida
Menu --> "0..1" Cidade : vez atual
Menu --> "1" Mercado
Menu --> "1" Agricultura
Menu --> "1" Governo
Menu --> "1" Construcoes
Menu --> "1" Nobreza
Menu --> "1" Eventos
Eventos ..> Cidade : usa
Testes ..> Eventos : testa
Partida o--> "1..4" Cidade : cidades
Cidade --> "1" Jogador : dono
Partida ..> Nobreza : usa
Mercado ..> Cidade : usa
Agricultura ..> Cidade : usa
Governo ..> Cidade : usa
Construcoes ..> Cidade : usa
Nobreza ..> Cidade : usa
Nobreza ..> Jogador : promove
Testes ..> Cidade : testa
Testes ..> Mercado : testa
Testes ..> Agricultura : testa
Testes ..> Governo : testa
Testes ..> Construcoes : testa
Testes ..> Nobreza : testa
Testes ..> Partida : testa
Testes ..> Jogador : testa
@enduml
