@startuml diagrama-classes
!pragma layout smetana
title Bolonha e Milano - Diagrama de classes (Etapa 1)
skinparam classAttributeIconSize 0
hide empty members

class Main {
  + {static} main(args: String[]): void
}

class Menu {
  - scanner: Scanner
  - emExecucao: boolean
  + executar(): void
  - exibirOpcoes(): void
  - lerOpcao(): int
  - processarOpcao(opcao: int): void
  - exibirSobre(): void
}

Main ..> Menu : cria e usa
@enduml
